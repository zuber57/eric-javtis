{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "background_color",
      "label": "Background Color",
      "default": "linear-gradient(45deg, transparent, #898989)"
    },
    {
      "type": "text",
      "id": "overlay_color",
      "label": "Overlay (RGBA)",
      "default": "rgba(0,0,0,0.3)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Eric Javits Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Lorem Ipsum is simply dummy text of the printing and typesetting industry."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
.custom-banner {
  background: {{ section.settings.background_color }};
  position: relative;
  padding: 8px 0px 0;
  overflow: hidden;
}

.custom-banner .overlay {
  background-color: {{ section.settings.overlay_color }};
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}
{% endstyle %}

<div class="custom-banner reverse">
  <div class="overlay"></div>

  <div class="banner-inner page-width">
    {% if section.settings.banner_image %}
      <div class="banner-image">
        <img 
          src="{{ section.settings.banner_image | img_url: 'master' }}" 
          height="100%" 
          width="100%" 
          alt="Banner Image" 
        />
      </div>
    {% endif %}

    <div class="banner-content">
      <h2 class="banner-titlecus">{{ section.settings.heading }}</h2>
      <p class="banner-subtext">{{ section.settings.description }}</p>

      {% if section.settings.button_text %}
        <a href="{{ section.settings.button_link }}" class="banner-button">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
